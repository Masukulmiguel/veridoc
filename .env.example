# VeriDoc — variáveis de ambiente (copiar para .env e preencher)
# Nunca colocar valores reais no Git.

# --- Aplicação ---
ENVIRONMENT=development
PROJECT_NAME=VeriDoc

# --- Base de dados ---
# SQLite (desenvolvimento/tests)
# DATABASE_URL=sqlite:///./veridoc.db
# PostgreSQL (produção/docker)
DATABASE_URL=postgresql+psycopg://veridoc:veridoc@db:5432/veridoc

# --- PostgreSQL (Docker) ---
POSTGRES_USER=veridoc
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=veridoc

# --- Segurança JWT ---
# Trocar por um valor aleatório e longo em produção
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth 2.0 / OpenID Connect ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Chaves de assinatura digital ---
PRIVATE_KEY_PATH=keys/veridoc_private.pem
PUBLIC_KEY_PATH=keys/veridoc_public.pem

# --- URLs ---
VERIDOC_PUBLIC_URL=https://veridoc.ao
FRONTEND_URL=http://localhost

# --- CORS (separar por vírgula) ---
# Nunca usar "*" em produção
CORS_ORIGINS=http://localhost

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api
VITE_USE_MOCKS=false
